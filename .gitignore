# Dependencies (no trailing slash: a Devis worktree links its source's node_modules, and git sees that link as a file)
node_modules

# The commit a packaged build came from (scripts/package-desktop.mjs)
build-info.json

# Runtime state (SQLite review store)
data/

# User-local config (orgs/projects/selected model) — never commit; seeded on first run
config.json

# Compiled backend output (src/*.mts -> root *.mjs)
/*.mjs

# Compiled frontend output (web/src/*.ts -> web/*.js)
/web/*.js

# Logs
*.log

# Packaged desktop app (scripts/package-desktop.mjs)
out/
